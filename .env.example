# All optional. The app runs fully offline with no configuration.

# Server-side secrets. Never prefix these with VITE_ or NEXT_PUBLIC_.
# If unset, a random secret is generated at boot (sessions reset on restart).
SESSION_SECRET=
STEP_UP_SECRET=

# Ports
PORT=8787

# Mock model streaming speed (ms between 2-4 char chunks). 0 = instant.
MOCK_DELAY_MS=25

# Optional: use a real local model via Ollama instead of the mock.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Gateway limits (hardened mode)
RATE_LIMIT_PER_MINUTE=30
MAX_INPUT_CHARS=4000
